<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#ECECEC"
    android:backgroundTint="@color/white">

    <!-- CABECERA -->

    <LinearLayout
        android:id="@+id/layoutCabecera"
        android:layout_width="0dp"
        android:layout_height="55dp"
        android:layout_margin="20dp"
        android:background="@android:drawable/btn_default"
        android:backgroundTint="#228557"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnVolver"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:src="@android:drawable/ic_media_previous" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="NUEVO GASTO"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- IMPORTE -->

    <EditText
        android:id="@+id/etImporte"
        android:layout_width="0dp"
        android:layout_height="55dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="30dp"
        android:layout_marginEnd="20dp"
        android:background="@android:drawable/editbox_background"
        android:hint="Importe:"
        android:inputType="numberDecimal"
        android:padding="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutCabecera" />

    <!-- CONCEPTO -->

    <EditText
        android:id="@+id/etConcepto"
        android:layout_width="0dp"
        android:layout_height="55dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="20dp"
        android:background="@android:drawable/editbox_background"
        android:hint="Concepto:"
        android:padding="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/etImporte" />

    <!-- CATEGORÍAS -->

    <GridLayout
        android:id="@+id/gridCategorias"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="25dp"
        android:columnCount="3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/etConcepto">

        <Button
            android:id="@+id/btnCasa"
            android:layout_width="80dp"
            android:layout_height="50dp"
            android:backgroundTint="@color/white"
            android:text="🏠" />

        <Button
            android:id="@+id/btnCompras"
            android:layout_width="80dp"
            android:layout_height="50dp"
            android:backgroundTint="#228557"
            android:text="🏪" />

        <Button
            android:id="@+id/btnFamilia"
            android:layout_width="80dp"
            android:layout_height="50dp"
            android:backgroundTint="@color/white"
            android:text="👨‍👩‍👧" />

        <Button
            android:id="@+id/btnTransporte"
            android:layout_width="80dp"
            android:layout_height="50dp"
            android:backgroundTint="@color/white"
            android:text="🚗" />

        <Button
            android:id="@+id/btnOcio"
            android:layout_width="80dp"
            android:layout_height="50dp"
            android:backgroundTint="@color/white"
            android:text="🎭" />

        <Button
            android:id="@+id/btnOtros"
            android:layout_width="80dp"
            android:layout_height="50dp"
            android:backgroundTint="@color/white"
            android:text="..."
            android:textColor="@color/black" />

    </GridLayout>

    <!-- FECHA -->

    <EditText
        android:id="@+id/etFecha"
        android:layout_width="0dp"
        android:layout_height="55dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="25dp"
        android:layout_marginEnd="20dp"
        android:background="@android:drawable/editbox_background"
        android:focusable="false"
        android:hint="Fecha:"
        android:padding="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/gridCategorias" />

    <!-- GUARDAR -->

    <Button
        android:id="@+id/btnGuardar"
        android:layout_width="0dp"
        android:layout_height="55dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="25dp"
        android:layout_marginEnd="20dp"
        android:backgroundTint="#228557"
        android:text="GUARDAR INGRESO"
        android:textColor="#FFFFFF"
        app:icon="@drawable/ic_confirmado"
        app:iconTintMode="multiply"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/etFecha" />

    <!-- CANCELAR -->

    <Button
        android:id="@+id/btnCancelar"
        android:layout_width="0dp"
        android:layout_height="55dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="25dp"
        android:layout_marginEnd="20dp"
        android:backgroundTint="#228557"
        android:text="CANCELAR"
        android:textColor="#FFFFFF"
        app:icon="@android:drawable/btn_dialog"
        app:iconTintMode="multiply"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnGuardar" />

</androidx.constraintlayout.widget.ConstraintLayout>